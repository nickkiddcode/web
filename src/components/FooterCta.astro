---
// The page turns dark for the ask: the mark, a rule, the headline, then the ways to reach Nick
// and the name oversized along the bottom edge.
// The mailto href is assembled client-side (light obfuscation, per the no-contact-form rule).
const LOGO = '/assets/6661e5a0af31c8694ab62e06_665f43a979bbd64b9828e072_nkpurple.png';
const year = new Date().getFullYear();
---

<footer class="nk-foot mesh" style="animation-delay:-3s">
  {/* the shader mesh paints here; if WebGL isn't available the canvas stays empty and
      the CSS .mesh background underneath shows instead */}
  <canvas class="nk-foot-canvas" aria-hidden="true"></canvas>
  <div class="nk-foot-top">
    <span class="nk-foot-mark" data-blur><img src={LOGO} alt="" width="96" height="96" /></span>
    <div class="nk-foot-rule">
      <h2 data-blur>Hiring a creative leader?</h2>
    </div>
  </div>

  <div class="nk-foot-cols">
    <div data-blur>
      <p class="nk-foot-label">Get in touch</p>
      <a class="nk-foot-mail" href="#" data-eml="contact" data-dmn="nickkidd.net">
        contact<span aria-hidden="true">&#64;</span>nickkidd.net
      </a>
      <p class="nk-foot-where">Dallas–Fort Worth · Remote</p>
    </div>
    <div class="nk-foot-links" data-blur>
      <a href="https://www.linkedin.com/in/nickkidd/" target="_blank" rel="noopener">LinkedIn</a>
      <a href="/assets/nick-kidd-resume.pdf">Resume (PDF)</a>
    </div>
    <div class="nk-foot-meta" data-blur>
      <span>© {year} Nick Kidd</span>
      <span>Creative Director</span>
    </div>
  </div>

  <div class="nk-foot-word" aria-hidden="true"><span>NICK KIDD</span></div>
</footer>

<script>
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-eml]')) {
    a.href = `mailto:${a.dataset.eml}@${a.dataset.dmn}`;
  }
</script>

<script>
  // The footer's purple as a true mesh gradient: a fragment shader layers a few
  // slow, domain-warped simplex-noise fields and uses each one to blend in another
  // shade of the brand purple — so colours flow into each other with no shapes or
  // edges to read, the way Stripe's hero gradient works. It's soft by nature, so it
  // renders at quarter resolution and is stretched up, capped at 30fps; the grain is a
  // separate CSS overlay on top (grain drawn at quarter-res would smear). Only animates while the
  // footer is on screen; one still frame under reduced motion.
  const canvas = document.querySelector<HTMLCanvasElement>('.nk-foot-canvas');
  const gl = canvas?.getContext('webgl', { antialias: false, premultipliedAlpha: false });

  if (canvas && gl) {
    const vert = `attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;
    const frag = `
      precision highp float;
      uniform vec2 uRes;
      uniform float uTime;

      // 3D simplex noise — Ashima Arts / Stefan Gustavson (MIT)
      vec3 mod289(vec3 x){ return x - floor(x * (1.0/289.0)) * 289.0; }
      vec4 mod289(vec4 x){ return x - floor(x * (1.0/289.0)) * 289.0; }
      vec4 permute(vec4 x){ return mod289(((x*34.0)+1.0)*x); }
      vec4 taylorInvSqrt(vec4 r){ return 1.79284291400159 - 0.85373472095314 * r; }
      float snoise(vec3 v){
        const vec2 C = vec2(1.0/6.0, 1.0/3.0);
        const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
        vec3 i = floor(v + dot(v, C.yyy));
        vec3 x0 = v - i + dot(i, C.xxx);
        vec3 g = step(x0.yzx, x0.xyz);
        vec3 l = 1.0 - g;
        vec3 i1 = min(g.xyz, l.zxy);
        vec3 i2 = max(g.xyz, l.zxy);
        vec3 x1 = x0 - i1 + C.xxx;
        vec3 x2 = x0 - i2 + C.yyy;
        vec3 x3 = x0 - D.yyy;
        i = mod289(i);
        vec4 p = permute(permute(permute(
                  i.z + vec4(0.0, i1.z, i2.z, 1.0))
                + i.y + vec4(0.0, i1.y, i2.y, 1.0))
                + i.x + vec4(0.0, i1.x, i2.x, 1.0));
        float n_ = 0.142857142857;
        vec3 ns = n_ * D.wyz - D.xzx;
        vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
        vec4 x_ = floor(j * ns.z);
        vec4 y_ = floor(j - 7.0 * x_);
        vec4 x = x_ * ns.x + ns.yyyy;
        vec4 y = y_ * ns.x + ns.yyyy;
        vec4 h = 1.0 - abs(x) - abs(y);
        vec4 b0 = vec4(x.xy, y.xy);
        vec4 b1 = vec4(x.zw, y.zw);
        vec4 s0 = floor(b0) * 2.0 + 1.0;
        vec4 s1 = floor(b1) * 2.0 + 1.0;
        vec4 sh = -step(h, vec4(0.0));
        vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
        vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;
        vec3 p0 = vec3(a0.xy, h.x);
        vec3 p1 = vec3(a0.zw, h.y);
        vec3 p2 = vec3(a1.xy, h.z);
        vec3 p3 = vec3(a1.zw, h.w);
        vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2,p2), dot(p3,p3)));
        p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
        vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
        m = m * m;
        return 42.0 * dot(m*m, vec4(dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3)));
      }

      void main(){
        vec2 uv = gl_FragCoord.xy / uRes;
        vec2 p = uv * vec2(uRes.x / uRes.y, 1.0) * 0.9;
        float t = uTime * 0.045;

        // warp the domain with one noise field, then read the colour fields through it
        vec2 w = vec2(snoise(vec3(p, t)), snoise(vec3(p + 4.3, t)));
        vec2 q = p + w * 0.55;

        float n1 = snoise(vec3(q * 0.8, t * 1.1));
        float n2 = snoise(vec3(q * 1.1 + 2.7, t * 0.8));
        float n3 = snoise(vec3(q * 0.6 - 5.1, t * 0.6));
        float n4 = snoise(vec3(q * 1.4 + 9.2, t * 1.3));

        vec3 brand  = vec3(0.380, 0.000, 0.725);  // #6100b9
        vec3 deep   = vec3(0.149, 0.016, 0.353);  // #26045a
        vec3 indigo = vec3(0.247, 0.000, 0.525);  // #3f0086
        vec3 violet = vec3(0.455, 0.157, 1.000);  // #7428ff
        vec3 orchid = vec3(0.706, 0.235, 1.000);  // #b43cff
        vec3 plum   = vec3(0.557, 0.063, 0.784);  // #8e10c8
        vec3 lilac  = vec3(0.780, 0.576, 1.000);  // #c793ff

        vec3 col = brand;
        col = mix(col, indigo, smoothstep(-0.6, 0.6, n3) * 0.8);
        col = mix(col, violet, smoothstep(-0.3, 0.8, n1) * 0.85);
        col = mix(col, plum,   smoothstep(0.0, 0.9, n2) * 0.7);
        col = mix(col, deep,   smoothstep(0.1, 0.9, -n1 * 0.6 - n3 * 0.5) * 0.9);
        col = mix(col, orchid, smoothstep(0.35, 1.0, n4) * 0.75);
        col = mix(col, lilac,  smoothstep(0.55, 1.0, n1 * 0.6 + n4 * 0.5) * 0.7);

        gl_FragColor = vec4(col, 1.0);
      }
    `;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);

    if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uRes = gl.getUniformLocation(prog, 'uRes');
      const uTime = gl.getUniformLocation(prog, 'uTime');

      const SCALE = 0.25;
      const resize = () => {
        const r = canvas.getBoundingClientRect();
        canvas.width = Math.max(1, Math.round(r.width * SCALE));
        canvas.height = Math.max(1, Math.round(r.height * SCALE));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
      };

      // start somewhere into the loop so the first frame isn't the noise origin
      const t0 = performance.now() - 40000;
      const draw = (now: number) => {
        gl.uniform1f(uTime, (now - t0) / 1000);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };

      resize();
      new ResizeObserver(() => { resize(); draw(performance.now()); }).observe(canvas);
      canvas.classList.add('is-live');

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        draw(performance.now());
      } else {
        let raf = 0;
        let last = 0;
        const loop = (now: number) => {
          if (now - last > 33) { draw(now); last = now; }
          raf = requestAnimationFrame(loop);
        };
        new IntersectionObserver(([e]) => {
          if (e.isIntersecting) { if (!raf) raf = requestAnimationFrame(loop); }
          else { cancelAnimationFrame(raf); raf = 0; }
        }).observe(canvas);
      }
    }
  }
</script>

<script>
  // the name signs off the footer at exactly the width of the column: measure the real
  // rendered text and scale to fit, so no font or device can push it past the edge
  const word = document.querySelector<HTMLElement>('.nk-foot-word');
  const name = word?.querySelector<HTMLElement>('span');
  if (word && name) {
    const fit = () => {
      name.style.fontSize = '';
      const avail = word.clientWidth;
      const used = name.getBoundingClientRect().width;
      if (avail && used) {
        const size = parseFloat(getComputedStyle(name).fontSize);
        name.style.fontSize = (size * (avail / used) * 0.99).toFixed(2) + 'px';
      }
    };
    fit();
    document.fonts?.ready.then(fit);
    new ResizeObserver(fit).observe(word);
  }
</script>

<style is:global>
  .nk-foot {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #eff1f3;
    padding: clamp(34px, 5vh, 72px) clamp(18px, 4.4vw, 64px) 0;
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 6vh, 76px);
  }
  /* the shader mesh sits behind the footer's content; the grain rides above the
     canvas (a later sibling in paint order) but still below the content */
  .nk-foot-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    display: block;
  }
  .nk-foot::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('/assets/grain.svg') 0 0 / 240px 240px;
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  .nk-foot-top { display: flex; flex-direction: column; gap: clamp(18px, 2.4vh, 30px); }
  .nk-foot-mark { align-self: flex-end; display: block; line-height: 0; }
  /* the mark is the purple PNG, knocked out to white for the dark ground —
     on the image itself, since the blur reveal animates filter on the wrapper */
  .nk-foot-mark img { width: clamp(46px, 6.6vw, 96px); height: auto; display: block; filter: brightness(0) invert(1); }
  .nk-foot-rule { border-top: 1px solid rgba(255, 255, 255, 0.24); padding-top: clamp(28px, 4.4vh, 56px); }
  .nk-foot-rule h2 {
    margin: 0; max-width: 16ch; color: #eff1f3;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(34px, 6vw, 86px); line-height: 0.98; letter-spacing: -0.025em; font-weight: 500;
  }
  .nk-foot-cols {
    border-top: 1px solid rgba(255, 255, 255, 0.24); padding-top: clamp(26px, 3.6vh, 46px);
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(22px, 3vw, 48px); align-items: start;
  }
  .nk-foot-label {
    margin: 0 0 18px; font-size: clamp(9px, 0.8vw, 11px); font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: #c9b0ec;
  }
  .nk-foot-mail {
    color: #eff1f3; font-size: clamp(15px, 1.5vw, 20px); text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.38); padding-bottom: 3px;
  }
  .nk-foot-mail:hover, .nk-foot-links a:hover { border-color: #eff1f3; }
  .nk-foot-where { margin: 18px 0 0; font-size: clamp(12px, 1.1vw, 15px); line-height: 1.55; color: #d3c0f0; }
  .nk-foot-links { display: flex; flex-direction: column; gap: 12px; font-size: clamp(14px, 1.3vw, 17px); }
  .nk-foot-links a {
    color: #eff1f3; text-decoration: none; border-bottom: 1px solid rgba(255, 255, 255, 0.38);
    padding-bottom: 3px; width: max-content;
  }
  .nk-foot-meta {
    display: flex; flex-direction: column; gap: 8px; text-align: right;
    font-size: clamp(9px, 0.8vw, 11px); font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: #c9b0ec;
  }
  /* the name signs off the footer: sized to the column so the whole of it reads,
     never clipped by the page edge. The font-size below is a deliberately safe
     starting guess (fits with room to spare); the script fits it exactly against
     the real rendered text, so a slow font load or a slightly different metric
     can only ever leave it a touch small, never cropped. */
  .nk-foot-word { margin-top: clamp(8px, 2vh, 30px); padding: 0.06em 0 clamp(18px, 3vh, 44px); overflow: hidden; }
  .nk-foot-word span {
    display: inline-block; white-space: nowrap; max-width: 100%;
    font-family: var(--font-heading, sans-serif);
    font-size: 14vw;
    line-height: 0.9; letter-spacing: -0.04em;
    font-weight: 500; color: rgba(255, 255, 255, 0.07);
  }

  @media (max-width: 860px) {
    .nk-foot-cols { grid-template-columns: 1fr; }
    .nk-foot-meta { text-align: left; }
  }
</style>
