---
// Homepage preloader — the NK mark in the brand mesh over the page's own off-white, a
// hairline filling underneath as the page actually loads (fonts, then everything else),
// then the panel wipes up into the hero. Once per visit: a return to Home in the same
// session goes straight in.
//
// Whether it shows at all is decided in <head> (Base.astro, `preloader` prop) before the
// first paint, by putting .is-preloading on <html> — so there's never a flash of the page
// underneath, and with JS off (or reduced motion) the panel simply never appears.
const MARK = '/assets/665f43a979bbd64b9828e072_nkpurple.png';
---

<div class="preloader" data-preloader aria-hidden="true">
  <span class="preloader-mark mesh mesh-mask" style={`--mask:url(${MARK})`}></span>
  <span class="preloader-track"><span class="preloader-fill" data-preloader-fill></span></span>
</div>

<script>
  const html = document.documentElement;
  const pre = document.querySelector<HTMLElement>('[data-preloader]');
  const fill = document.querySelector<HTMLElement>('[data-preloader-fill]');

  if (pre && fill && html.classList.contains('is-preloading')) {
    const MIN = 900;   // never just a flash
    const MAX = 5000;  // never a wall
    const start = performance.now();
    let fontsReady = false, pageReady = document.readyState === 'complete';
    document.fonts?.ready.then(() => { fontsReady = true; });
    if (!pageReady) window.addEventListener('load', () => { pageReady = true; }, { once: true });

    // the line eases toward a target that reflects what's actually loaded, and creeps
    // on its own so a slow asset never reads as a frozen screen. Easing is by elapsed
    // time, not per frame, so a slow device finishes on the same schedule; once ready,
    // the line gets 350ms to close out and then it goes, full or not.
    const CLOSE = 350;
    let shown = 0, last = start, readyAt = 0, done = false;
    const tick = (now: number) => {
      const t = now - start;
      const dt = now - last; last = now;
      if (!readyAt && ((fontsReady && pageReady && t >= MIN) || t >= MAX)) readyAt = now;
      const target = readyAt ? 100 : Math.min(88, (fontsReady ? 35 : 10) + (pageReady ? 40 : 0) + t / 60);
      shown += (target - shown) * (1 - Math.exp(-dt / (readyAt ? 70 : 260)));
      fill.style.transform = `scaleX(${shown / 100})`;
      if (readyAt && now - readyAt >= CLOSE && !done) {
        done = true;
        fill.style.transform = 'scaleX(1)';
        finish();
        return;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    const finish = () => {
      try { sessionStorage.setItem('nk-preloaded', '1'); } catch {}
      // the hero sets its entrance start-state now, while it's still covered…
      window.dispatchEvent(new Event('nk:preloaded'));
      // …then the panel wipes up to reveal it
      requestAnimationFrame(() => pre.classList.add('is-leaving'));
      const clear = () => { html.classList.remove('is-preloading'); pre.remove(); };
      pre.addEventListener('transitionend', (e) => { if (e.target === pre) clear(); });
      setTimeout(clear, 1600); // in case transitionend never arrives, never leave the page covered
    };
  } else {
    pre?.remove();
  }
</script>

<style is:global>
  .preloader { display: none; }
  html.is-preloading { overflow: hidden; }
  html.is-preloading .preloader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    background: var(--white, #f0efee);
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.9s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .preloader-mark {
    display: block;
    width: 64px;
    aspect-ratio: 294 / 188;
    /* its own fade-in, plus the mesh drift the .mesh class would otherwise supply */
    animation: preloader-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards, mesh-drift 20s ease-in-out infinite alternate;
    transition: opacity 0.3s ease, transform 0.5s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .preloader-track {
    position: relative;
    display: block;
    width: 96px;
    height: 1px;
    overflow: hidden;
    background: rgba(28, 28, 29, 0.12);
    animation: preloader-in 0.6s 0.1s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    transition: opacity 0.3s ease;
  }
  .preloader-fill {
    position: absolute;
    inset: 0;
    background: var(--purple, #6100b9);
    transform: scaleX(0);
    transform-origin: left;
  }
  /* exit: the mark and line step back first, then the whole panel wipes upward */
  html.is-preloading .preloader.is-leaving { clip-path: inset(0 0 100% 0); transition-delay: 0.15s; }
  .preloader.is-leaving .preloader-mark { opacity: 0; transform: translateY(-10px); }
  .preloader.is-leaving .preloader-track { opacity: 0; }

  @keyframes preloader-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
</style>
