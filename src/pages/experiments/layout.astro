---
// EXPERIMENT — homepage built from the wireframe: nav strip, then a split hero (reel left, name right),
// a staggered run of work rather than a grid, the rest as lines, and a dark footer.
// Everything below the hero arrives with a blur reveal on scroll. Not linked from anywhere, noindex.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// the run: each slot has its own width, and the emphasis comes from that width
const SLOTS = ['full', 'right', 'left', 'full', 'tall', 'offset'] as const;
const featured = projects.slice(0, SLOTS.length).map((p, i) => ({ p, slot: SLOTS[i] }));
const rest = projects.slice(SLOTS.length);
const LOGO = '/assets/6661e5a0af31c8694ab62e06_665f43a979bbd64b9828e072_nkpurple.png';
---

<Base title="Nick Kidd — Creative Director" bodyClass="body layout-body" footer={false} noindex>
  <main class="lay">
    <!-- Hero: the reel holds the left, the name the right -->
    <section class="lay-hero">
      <div class="lay-reel">
        <video
          src="/assets/reel-2026.mp4"
          poster="/assets/reel-2026-poster.jpg"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          aria-label="Showreel"
        ></video>
      </div>

      <div class="lay-intro">
        <p class="lay-eyebrow" data-blur>Creative Director<span> · Dallas–Fort Worth</span></p>
        <h1 class="lay-name" data-blur>
          <span>Nick</span>
          <span>Kidd</span>
        </h1>
        <p class="lay-title" data-blur>
          Over twelve years directing campaigns for Qualcomm, Fluence, Audi, Samsung and more.
        </p>
        <p class="lay-links" data-blur>
          <a href="mailto:contact@nickkidd.net">contact@nickkidd.net</a>
          <a href="https://www.linkedin.com/in/nickkidd/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="/assets/nick-kidd-resume.pdf">Resume (PDF)</a>
        </p>
      </div>
    </section>

    <!-- Work: a staggered run, not a grid -->
    <section class="lay-work" id="work">
      <p class="lay-label" data-blur>Selected work</p>

      <div class="lay-run">
        {featured.filter((f) => f.slot !== 'tall' && f.slot !== 'offset').map(({ p, slot }) => (
          <a href={`/projects/${p.id}`} class={`lay-piece is-${slot}`} data-blur>
            <div class="lay-piece-img">
              {p.data.image1 && (
                <Image src={p.data.image1} alt="" widths={[600, 1000, 1600]} sizes="(max-width: 900px) 100vw, 70vw" loading="lazy" />
              )}
            </div>
            <div class="lay-piece-line">
              <h2>{p.data.title}</h2>
              <span class="lay-pill">{p.data.category}</span>
            </div>
          </a>
        ))}

        <div class="lay-pair">
          {featured.filter((f) => f.slot === 'tall' || f.slot === 'offset').map(({ p, slot }) => (
            <a href={`/projects/${p.id}`} class={`lay-piece is-${slot}`} data-blur>
              <div class="lay-piece-img">
                {p.data.image1 && (
                  <Image src={p.data.image1} alt="" widths={[600, 1000, 1600]} sizes="(max-width: 900px) 100vw, 45vw" loading="lazy" />
                )}
              </div>
              <div class="lay-piece-line">
                <h2>{p.data.title}</h2>
                <span class="lay-pill">{p.data.category}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <ul class="lay-list">
        {rest.map((p) => (
          <li data-blur>
            <a href={`/projects/${p.id}`}>
              <span class="lay-list-title">{p.data.title}</span>
              <span class="lay-list-cat">{p.data.category}</span>
              <span class="lay-list-year">{p.data.year}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- The page turns dark for the ask -->
    <footer class="lay-foot">
      <div class="lay-foot-top">
        <span class="lay-foot-mark" data-blur><img src={LOGO} alt="" width="96" height="96" /></span>
        <div class="lay-foot-rule">
          <h2 data-blur>Hiring a creative leader?</h2>
        </div>
      </div>

      <div class="lay-foot-cols">
        <div data-blur>
          <p class="lay-foot-label">Get in touch</p>
          <a class="lay-foot-mail" href="mailto:contact@nickkidd.net">contact@nickkidd.net</a>
          <p class="lay-foot-where">Dallas–Fort Worth · Remote</p>
        </div>
        <div class="lay-foot-links" data-blur>
          <a href="https://www.linkedin.com/in/nickkidd/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="/assets/nick-kidd-resume.pdf">Resume (PDF)</a>
        </div>
        <div class="lay-foot-meta" data-blur>
          <span>© 2026 Nick Kidd</span>
          <span>Creative Director</span>
        </div>
      </div>

      <div class="lay-foot-word" aria-hidden="true"><span>NICK KIDD</span></div>
    </footer>
  </main>

  <script>
    import '../../scripts/reveal.js';
  </script>
</Base>

<style is:global>
  .layout-body { background: var(--color-page, #eff1f3); }
  /* the nav keeps its own full-width strip; the split starts beneath it */
  .layout-body .header {
    position: relative; z-index: 20;
    background: var(--color-page, #eff1f3);
    border-bottom: 1px solid rgba(28, 28, 29, 0.1);
  }
  .lay { --gutter: clamp(18px, 4.4vw, 64px); }

  /* ---- hero ---- */
  .lay-hero {
    display: grid;
    grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
    min-height: clamp(420px, calc(100svh - var(--nav-h, 116px)), 820px);
    align-items: stretch;
  }
  .lay-reel { position: relative; overflow: hidden; background: #1c1c1d; }
  .lay-reel video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lay-intro {
    display: flex; flex-direction: column; justify-content: center;
    gap: clamp(12px, 1.6vw, 22px);
    padding: clamp(28px, 6vh, 96px) var(--gutter);
  }
  .lay-eyebrow {
    margin: 0; font-size: clamp(9px, 0.8vw, 11px); font-weight: 600; letter-spacing: 0.15em;
    text-transform: uppercase; color: var(--color-purple, #6100b9);
  }
  .lay-name {
    margin: 0; display: grid;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(38px, 9.2vw, 132px); line-height: 0.86; letter-spacing: -0.03em; font-weight: 500;
    color: var(--color-ink, #1c1c1d);
  }
  .lay-title { margin: 0; max-width: 34ch; font-size: clamp(12.5px, 1.25vw, 18px); line-height: 1.5; color: #4a4e54; }
  .lay-links { margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 8px clamp(12px, 1.6vw, 24px); font-size: clamp(11.5px, 1vw, 14px); }
  .lay-links a {
    color: var(--color-ink, #1c1c1d); text-decoration: none;
    border-bottom: 1px solid rgba(28, 28, 29, 0.25); padding-bottom: 2px;
  }
  .lay-links a:hover { color: var(--color-purple, #6100b9); border-color: currentColor; }

  /* ---- work: the staggered run ---- */
  .lay-work { padding: clamp(52px, 9vh, 120px) var(--gutter) 0; }
  .lay-label {
    margin: 0 0 clamp(26px, 4vh, 40px); font-size: 11px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28, 28, 29, 0.5);
  }
  .lay-run { display: flex; flex-direction: column; gap: clamp(48px, 9vw, 120px); }
  .lay-piece { display: block; text-decoration: none; color: inherit; }
  /* the widths carry the emphasis, as percentages of the content column */
  .lay-piece.is-full { width: 100%; }
  .lay-piece.is-right { width: 74.7%; margin-left: auto; }
  .lay-piece.is-left { width: 58%; }
  .lay-pair { display: flex; align-items: flex-start; gap: clamp(24px, 9.4vw, 124px); }
  .lay-piece.is-tall { width: 32.6%; }
  .lay-piece.is-offset { width: 58%; margin-top: 14.5%; }
  .lay-piece-img { overflow: hidden; border-radius: 4px; background: #dfe2e6; aspect-ratio: 5 / 3; }
  .lay-piece.is-tall .lay-piece-img { aspect-ratio: 13 / 20; }
  .lay-piece-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .lay-piece:hover .lay-piece-img img { transform: scale(1.03); }
  .lay-piece-line {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 18px;
  }
  .lay-piece-line h2 { margin: 0; font-size: clamp(17px, 1.9vw, 26px); font-weight: 500; letter-spacing: -0.01em; }
  .lay-pill {
    flex: none; font-size: clamp(9px, 0.8vw, 10px); letter-spacing: 0.14em; text-transform: uppercase;
    color: #4a4e54; border: 1px solid rgba(28, 28, 29, 0.18); border-radius: 999px; padding: 8px 15px; white-space: nowrap;
  }

  /* ---- the rest, as lines ---- */
  .lay-list { list-style: none; margin: clamp(56px, 9vh, 110px) 0 0; padding: 0; border-top: 1px solid rgba(28, 28, 29, 0.14); }
  .lay-list a {
    display: grid; grid-template-columns: 1fr auto auto; gap: clamp(12px, 2vw, 32px); align-items: baseline;
    padding: clamp(14px, 2vh, 22px) 0; border-bottom: 1px solid rgba(28, 28, 29, 0.14);
    text-decoration: none; color: inherit;
  }
  .lay-list a:hover .lay-list-title { color: var(--color-purple, #6100b9); }
  .lay-list-title { font-size: clamp(16px, 1.8vw, 24px); font-weight: 500; transition: color 0.2s ease; }
  .lay-list-cat, .lay-list-year { font-size: clamp(9px, 0.8vw, 10px); letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28, 28, 29, 0.5); }

  /* ---- footer: the page turns dark ---- */
  .lay-foot {
    margin-top: clamp(64px, 12vh, 150px);
    background: #141415; color: #eff1f3;
    padding: clamp(34px, 5vh, 72px) var(--gutter) 0;
    display: flex; flex-direction: column; gap: clamp(36px, 6vh, 76px);
  }
  .lay-foot-top { display: flex; flex-direction: column; gap: clamp(18px, 2.4vh, 30px); }
  .lay-foot-mark { align-self: flex-end; display: block; line-height: 0; }
  /* the mark is the purple PNG, knocked out to white for the dark ground —
     on the image itself, since the reveal animates filter on the wrapper */
  .lay-foot-mark img { width: clamp(46px, 6.6vw, 96px); height: auto; display: block; filter: brightness(0) invert(1); }
  .lay-foot-rule { border-top: 1px solid #33343a; padding-top: clamp(28px, 4.4vh, 56px); }
  .lay-foot-rule h2 {
    margin: 0; max-width: 16ch;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(34px, 6vw, 86px); line-height: 0.98; letter-spacing: -0.025em; font-weight: 500;
  }
  .lay-foot-cols {
    border-top: 1px solid #33343a; padding-top: clamp(26px, 3.6vh, 46px);
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(22px, 3vw, 48px); align-items: start;
  }
  .lay-foot-label { margin: 0 0 18px; font-size: clamp(9px, 0.8vw, 11px); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #7e838b; }
  .lay-foot-mail { color: #eff1f3; font-size: clamp(15px, 1.5vw, 20px); text-decoration: none; border-bottom: 1px solid #45464d; padding-bottom: 3px; }
  .lay-foot-mail:hover, .lay-foot-links a:hover { border-color: #eff1f3; }
  .lay-foot-where { margin: 18px 0 0; font-size: clamp(12px, 1.1vw, 15px); line-height: 1.55; color: #8b9098; }
  .lay-foot-links { display: flex; flex-direction: column; gap: 12px; font-size: clamp(14px, 1.3vw, 17px); }
  .lay-foot-links a { color: #eff1f3; text-decoration: none; border-bottom: 1px solid #45464d; padding-bottom: 3px; width: max-content; }
  .lay-foot-meta {
    display: flex; flex-direction: column; gap: 8px; text-align: right;
    font-size: clamp(9px, 0.8vw, 11px); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #7e838b;
  }
  /* the name, oversized along the bottom edge and cropped by the page */
  .lay-foot-word { margin-top: clamp(8px, 2vh, 30px); height: clamp(72px, 14vw, 200px); overflow: hidden; }
  .lay-foot-word span {
    display: block; white-space: nowrap;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(94px, 18.6vw, 268px); line-height: 0.78; letter-spacing: -0.04em; font-weight: 500; color: #24252b;
  }

  /* ---- blur reveal ---- */
  [data-blur] {
    opacity: 0; filter: blur(14px); transform: translateY(26px);
    transition: opacity 0.7s ease, filter 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-blur].is-in { opacity: 1; filter: blur(0); transform: none; }
  @media (prefers-reduced-motion: reduce) {
    [data-blur] { opacity: 1; filter: none; transform: none; transition: none; }
  }

  /* ---- narrow screens: the split holds, the run straightens out ---- */
  @media (max-width: 900px) {
    .lay-hero { grid-template-columns: minmax(0, 36fr) minmax(0, 64fr); min-height: clamp(320px, 48svh, 520px); }
    .lay-intro { justify-content: flex-start; gap: 8px; padding-block: clamp(16px, 3vh, 28px); }
    .lay-eyebrow span { display: none; }
    .lay-links { flex-direction: column; align-items: flex-start; }
    .lay-pair { flex-direction: column; gap: clamp(48px, 9vw, 120px); }
    .lay-piece.is-full, .lay-piece.is-right { width: 100%; }
    .lay-piece.is-offset { width: 100%; margin-top: 0; }
    .lay-piece.is-left { width: 80%; }
    .lay-piece.is-tall { width: 64%; }
    .lay-foot-cols { grid-template-columns: 1fr; }
    .lay-foot-meta { text-align: left; }
    .lay-list a { grid-template-columns: 1fr auto; }
    .lay-list-year { display: none; }
  }
</style>
